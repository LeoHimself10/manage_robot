# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# Demo runtime artifacts (audit JSONL, plan snapshots; see .env.example)
data/

# Local agent eval scratch (sessions / sqlite / logs)
.eval-data/

# One-off ops/inspect scripts (executed against ECS sqlite, not part of source tree)
.tmp/

# ECS / local snapshots (may contain manage-robot.env secrets)
backups/

# Local notes (do not commit)
agent-maturity-assessment.md

# Never commit SSH keys under docs/ (keep outside repo, e.g. Downloads)
docs/*.pem

# Local git worktrees
.worktrees/

# IDE (optional — remove lines if you prefer to commit these)
.idea/
.claude/
