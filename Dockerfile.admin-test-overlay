FROM manage-robot:dingtalk-0bc0a78

RUN mkdir -p /app/src/testing
RUN mkdir -p /app/src/quality/presentation

COPY src/testing/admin-test-actors.ts /app/src/testing/admin-test-actors.ts
COPY src/quality/presentation/quality-role-metrics.ts /app/src/quality/presentation/quality-role-metrics.ts
COPY src/quality/presentation/quality-display-labels.ts /app/src/quality/presentation/quality-display-labels.ts
COPY src/web/workbench-admin-impersonation.ts /app/src/web/workbench-admin-impersonation.ts
COPY src/security/workbench-role-resolver.ts /app/src/security/workbench-role-resolver.ts
COPY src/integrations/dingtalk/workbench-notify.ts /app/src/integrations/dingtalk/workbench-notify.ts
COPY scripts/seed-admin-test-actors.ts /app/scripts/seed-admin-test-actors.ts
COPY scripts/seed-admin-test-quality-data.ts /app/scripts/seed-admin-test-quality-data.ts
COPY scripts/docker-entrypoint-dingtalk.sh /app/scripts/docker-entrypoint-dingtalk.sh
COPY scripts/patch-yesterday-admin-test-overlay.mjs /tmp/patch-yesterday-admin-test-overlay.mjs

RUN node /tmp/patch-yesterday-admin-test-overlay.mjs \
  && rm /tmp/patch-yesterday-admin-test-overlay.mjs \
  && sed -i 's/\r$//' /app/scripts/docker-entrypoint-dingtalk.sh \
  && chmod +x /app/scripts/docker-entrypoint-dingtalk.sh

# These files contain the final isolated quality-role flow after the deterministic
# yesterday-source patch above. Copying the reviewed final sources keeps a later
# overlay build identical to the source and tests in this worktree.
COPY src/quality/assignments/quality-supervisor-directory.ts /app/src/quality/assignments/quality-supervisor-directory.ts
COPY src/quality/presentation/quality-event-perspective.ts /app/src/quality/presentation/quality-event-perspective.ts
COPY src/quality/testing/quality-feature-flags.ts /app/src/quality/testing/quality-feature-flags.ts
COPY src/quality/testing/quality-test-actors.ts /app/src/quality/testing/quality-test-actors.ts
COPY src/quality/testing/quality-test-boundary.ts /app/src/quality/testing/quality-test-boundary.ts
COPY src/quality/testing/quality-test-analysis-service.ts /app/src/quality/testing/quality-test-analysis-service.ts
COPY src/quality/testing/quality-test-aftersales-service.ts /app/src/quality/testing/quality-test-aftersales-service.ts
COPY src/quality/testing/quality-test-ai-service.ts /app/src/quality/testing/quality-test-ai-service.ts
COPY src/quality/ai-original-assessment/qwen-ai-original-assessment-model.ts /app/src/quality/ai-original-assessment/qwen-ai-original-assessment-model.ts
COPY src/quality/ai-original-assessment/ai-original-assessment-v0-prompt.ts /app/src/quality/ai-original-assessment/ai-original-assessment-v0-prompt.ts
COPY src/quality/ai-original-assessment/ai-original-assessment-v0-context.ts /app/src/quality/ai-original-assessment/ai-original-assessment-v0-context.ts
COPY src/web/quality-http.ts /app/src/web/quality-http.ts
COPY src/web/quality-tracking-page.ts /app/src/web/quality-tracking-page.ts
