# 复制为 .env 并填入密钥（.env 已被 git 忽略，切勿提交）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型 qwen3.6-plus（支持 function calling + thinking）；可通过 QWEN_MODEL 覆盖
# QWEN_MODEL=qwen3.6-plus
# Qwen3 thinking 模式默认开启；`QWEN_THINKING=0|false|no` 时关闭
# QWEN_THINKING=0
# 单次请求超时（毫秒）。thinking 模式建议 60000+，避免 Abort / fetch failed
# QWEN_TIMEOUT_MS=60000
# QWEN_MAX_RETRIES=2
# OpenAI 兼容 SSE 流式拼装 JSON（默认开启）；关闭请设 QWEN_STREAM=0
# QWEN_STREAM=0

# 延迟相关（可选，见 docs/Qwen-接入实施说明.md）
# MVP 快速档建议：QWEN_MAX_RETRIES=0 + DEMO_LLM_CORRECTION=0 + QWEN_MAX_TOKENS=1800~2200
# 可略降生成等待和尾延迟；若出现 JSON 截断或一次校验失败增多，再逐项调回默认。
# QWEN_MAX_TOKENS=2000
# 更快失败、少一次 HTTP 退避：QWEN_MAX_RETRIES=0
# 校验失败后是否再调一轮模型做结构自纠正（默认开）；关可省一次调用、失败率或升
# DEMO_LLM_CORRECTION=0
# 钉钉多轮会话写入 user prompt 的上轮摘要最大字符（默认 2000，有效范围 200–8000）
# SESSION_DIGEST_MAX_CHARS=1200
# 钉钉入口按身份路由 agent（manager/employee/planner）开关；默认关闭
# DINGTALK_ROLE_ROUTING_ENABLED=0

# WBS 细拆：钉钉单次 LLM 输出 token（默认 8000）；整轮 ReAct token 预算（默认 24000）
# DINGTALK_QWEN_MAX_TOKENS=8000
# DINGTALK_QWEN_TIMEOUT_MS=120000
# AGENT_MAX_TOTAL_TOKENS=24000

# 钉钉开放平台「企业内部应用」Stream 机器人（https://open.dingtalk.com）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 钉钉网页应用免登 corpId（工作台 /workbench 自动免登使用）
# 工作台 /workbench：JSAPI 鉴权 dd.config 需要企业 corpId + 微应用 AgentId（开放平台「应用信息」中的 AgentId）。
# DINGTALK_CORP_ID=dingxxxxxxxxxxxxxxxx
# DINGTALK_AGENT_ID=123456789
# 员工通知总开关（发布/改派=卡片+机器人1:1；员工accept后=钉钉原生待办），默认关闭
# WORKBENCH_DINGTALK_NOTIFY_ENABLED=1
# 通知落地链接（未填时回退 ASSIGNMENT_WEB_PUBLIC_BASE_URL + /workbench/employee/task）
# WORKBENCH_NOTIFY_DETAIL_URL_BASE=https://your-ecs-host/workbench/employee/task
# 可选：覆盖通知使用的 AgentId（不填则复用 DINGTALK_AGENT_ID）
# WORKBENCH_DINGTALK_NOTIFY_AGENT_ID=123456789
# 员工拒绝/请求调整/阻塞/完成时通知主管（仅机器人 1:1 Markdown）；依赖 WORKBENCH_DINGTALK_NOTIFY_ENABLED；默认开启，可设 0 关闭
# WORKBENCH_DINGTALK_NOTIFY_MANAGER_ENABLED=1

# 执行中逾期催办（v1）：scheduler + 主管对话/工作台手动催办（需 WORKBENCH_DINGTALK_NOTIFY_ENABLED=1）
# FOLLOWUP_REMINDER_ENABLED=1
# FOLLOWUP_SCAN_INTERVAL_MS=300000
# FOLLOWUP_TIMEZONE=Asia/Shanghai
# FOLLOWUP_TIER2_AFTER_OVERDUE_DAYS=1
# FOLLOWUP_QUIET_HOURS=22:00-08:00
# FOLLOWUP_WEEKDAYS_ONLY=1
# FOLLOWUP_PRE_DUE_HOUR=10
# FOLLOWUP_PRE_DUE_MINUTE=0
# FOLLOWUP_MANUAL_LLM_ENABLED=1
# FOLLOWUP_MANUAL_LLM_TIMEOUT_MS=5000

# 每日任务进展推送（v1）：工作日定时汇总推送（需 WORKBENCH_DINGTALK_NOTIFY_ENABLED=1；默认经 qwen3.6-flash 生成概览/建议，表格由代码渲染；LLM 失败走模板 fallback）
# 编排 memory_context 注入完整 latestDraft 时的字符上限（超出则截断，默认 32000）
# ORCHESTRATOR_DRAFT_MEMORY_MAX_CHARS=32000
# v2 LangGraph 编排引擎（默认 legacy）：ORCHESTRATOR_ENGINE=v2 启用 codex 风格薄 harness
# ORCHESTRATOR_ENGINE=legacy
# v2 历史 compaction 阈值（字符）；超出则摘要旧轮次
# V2_HISTORY_COMPACT_CHARS=24000
# V2_HISTORY_COMPACT_KEEP_TURNS=6
# PROGRESS_DIGEST_ENABLED=1
# PROGRESS_DIGEST_MODE=delivery_reminder
# PROGRESS_DIGEST_HORIZON_DAYS=7
# 仅用于实例级人员隔离；逗号分隔。无未完成任务的人即使不配置也不会收到进展汇总。
# PROGRESS_DIGEST_EXCLUDE_USER_IDS=
# PROGRESS_DIGEST_SCAN_INTERVAL_MS=300000
# PROGRESS_DIGEST_TIMEZONE=Asia/Shanghai
# PROGRESS_DIGEST_HOUR=9
# PROGRESS_DIGEST_MINUTE=0
# PROGRESS_DIGEST_WEEKDAYS_ONLY=1
# PROGRESS_DIGEST_LOOKBACK_HOURS=24  # deprecated: activity uses previous calendar day in PROGRESS_DIGEST_TIMEZONE
# PROGRESS_DIGEST_MAX_TASK_LINES=8
# PROGRESS_DIGEST_LLM_ENABLED=0
# PROGRESS_DIGEST_LLM_MODEL=qwen3.6-flash
# PROGRESS_DIGEST_LLM_TIMEOUT_MS=8000
# PROGRESS_DIGEST_LLM_MAX_TOKENS=800

# 跨组织日报汇总群推送（v1）：每天 8:30(默认, 工作日)读取两个钉钉组织目标员工的「日志(日报)」，
# 原文汇总后经「自定义群机器人 Webhook(加签)」发到明思群。单实例假设(进程内 scheduler)。
# 凭证/员工名单/webhook 放在 JSON 配置文件里(含密钥，勿入库；建议放 data/ 或仓库外)，
# 主开关与时间可经下列 env 覆盖；JSON 模板见 config/daily-report-digest.example.json。
# 每个组织的企业内部应用需申请「查询企业员工日志权限」(topapi/report/list)。
# DAILY_REPORT_DIGEST_ENABLED=1
# DAILY_REPORT_DIGEST_CONFIG_FILE=data/daily-report-digest.config.json
# DAILY_REPORT_DIGEST_SCAN_INTERVAL_MS=300000
# DAILY_REPORT_DIGEST_TIMEZONE=Asia/Shanghai
# DAILY_REPORT_DIGEST_HOUR=8
# DAILY_REPORT_DIGEST_MINUTE=30
# DAILY_REPORT_DIGEST_WEEKDAYS_ONLY=1
# DAILY_REPORT_DIGEST_STATE_DIR=data/daily-report-digest
# 早报模式 LLM 综述（pushMode=morning 时；需 DASHSCOPE_API_KEY）
# DAILY_REPORT_MORNING_LLM_ENABLED=1
# DAILY_REPORT_MORNING_LLM_MODEL=qwen3.6-flash
# DAILY_REPORT_MORNING_LLM_TIMEOUT_MS=12000
# DAILY_REPORT_MORNING_LLM_MAX_TOKENS=900
# 工作台「日报汇总」只读页开关（实例级功能分叉）：默认关闭，仅 mingsibot 侧 env 打开即可只在明思出现。
# 页面/API/侧栏入口随此开关启停；与 8:30 群推(DAILY_REPORT_DIGEST_ENABLED)解耦，可单独使用。
# DAILY_REPORTS_PAGE_ENABLED=1

# 主管周度 Dashboard：工作台内按需查看，不做定时推送；建议助手 LLM 超时走模板 fallback
# WEEKLY_DASHBOARD_TIMEZONE=Asia/Shanghai
# WEEKLY_DASHBOARD_SPAN_MAX=6
# WEEKLY_DASHBOARD_FEED_PAGE_SIZE=50
# WEEKLY_DASHBOARD_FEED_MAX_PAGE_SIZE=100
# WEEKLY_ADVISOR_LLM_ENABLED=1
# WEEKLY_ADVISOR_LLM_MODEL=qwen3.6-flash
# WEEKLY_ADVISOR_LLM_TIMEOUT_MS=8000
# WEEKLY_ADVISOR_LLM_MAX_TOKENS=900

# 员工交付绩效看板（/workbench/manager/performance）：迟交/准时率/平均迟交天数/被催统计 + 隔离绩效问答 Agent
# 范围：主管看本人名下，admin/老板看全员。统计窗口按截止时间回溯。
# PERFORMANCE_DASHBOARD_ENABLED=1
# PERFORMANCE_WINDOW_DAYS=90

# 能力评估聊天（明思试点，仅白名单用户）
COMPETENCY_EVAL_ENABLED=0
COMPETENCY_EVAL_USER_IDS=01451725613871,641871342
# COMPETENCY_EVAL_USER_IDS_FILE=data/competency-eval-users.json
# 管理员首次在权限中心调整后，以此动态名单为准；默认写入 COMPETENCY_EVAL_DATA_DIR/access-users.json
# COMPETENCY_EVAL_MANAGED_USER_IDS_FILE=data/competency-eval/access-users.json
# COMPETENCY_EVAL_DATA_DIR=data/competency-eval
# COMPETENCY_EVAL_DEFAULT_WINDOW_DAYS=30
# COMPETENCY_EVAL_REPORT_MAX_CHARS=48000
# COMPETENCY_EVAL_MAX_RUBRICS_PER_USER=20
# 能力评估页 LLM thinking（默认 1；证据综合场景建议开启）
# COMPETENCY_EVAL_QWEN_THINKING=1

# 会议待办入库向导（Portfolio 主管）
# MEETING_IMPORT_LLM_ENABLED=1
# MEETING_IMPORT_LLM_MODEL=qwen3.6-flash
# MEETING_IMPORT_LLM_TIMEOUT_MS=30000
# MEETING_IMPORT_LLM_MAX_TOKENS=4000

# 任务快录入库（所有主管；见 docs/task-intake.md）
# TASK_INTAKE_ENABLED=1
# TASK_INTAKE_LLM_ENABLED=1
# TASK_INTAKE_LLM_MODEL=qwen3.6-flash
# TASK_INTAKE_LLM_TIMEOUT_MS=30000
# TASK_INTAKE_LLM_MAX_TOKENS=4000
# mingsibot 可选：最近会议 Tab。需钉钉应用授权 VideoConference.Conference.Read，并订阅闪记状态变更事件。
# TASK_INTAKE_DINGTALK_MEETINGS_ENABLED=0
# 统一会议读取：企业应用云转写无需主管个人授权；官方 dws OAuth 用于补查主管本人/共享的 taskUuid AI 听记。
# 每位主管使用隔离的 HOME，避免个人授权串号。profiles 文件格式：
# { "managerUserIdA": "/opt/manage_robot/dws-profiles/manager-a" }
# DINGTALK_MINUTES_DWS_ENABLED=0
# DINGTALK_MINUTES_DWS_PATH=/usr/local/bin/dws
# DINGTALK_MINUTES_DWS_PROFILES_FILE=/opt/manage_robot/data/dws-minutes-profiles.json
# 单主管试点也可用 DINGTALK_MINUTES_DWS_HOME，但必须同时配置允许使用该授权的 userId：
# DINGTALK_MINUTES_DWS_HOME=/opt/manage_robot/dws-profiles/pilot-manager
# DINGTALK_MINUTES_DWS_MANAGER_USER_IDS=managerUserIdA
# DINGTALK_MINUTES_DWS_TIMEOUT_MS=30000
# DINGTALK_MINUTES_DWS_MAX_PAGES=20
# 可选：主管任务详情链接根（不填则复用 ASSIGNMENT_WEB_PUBLIC_BASE_URL）
# WORKBENCH_NOTIFY_MANAGER_DETAIL_URL_BASE=https://your-ecs-host
# 可选：调试 Stream SDK（1 / true）
# DINGTALK_STREAM_DEBUG=1

# 可选：默认域提示 QUALITY | RD（不明确时可不设，交由模型判断）
# DEMO_DOMAIN_HINT=QUALITY

# search_web（planner 显式外部搜索时才可能暴露工具）
# SEARCH_WEB_ENABLED=1
# SEARCH_WEB_MODEL=qwen-turbo
# SEARCH_WEB_TIMEOUT_MS=8000
# SEARCH_WEB_STRATEGY=turbo

# 可选：健康检查端口（GET /health），便于阿里云负载均衡探活
# HEALTH_CHECK_PORT=8080

# Demo pipeline JSONL 审计（每条 createTaskPlanningDemo 完结一行）
# AUDIT_DEMO_JSONL_PATH=./data/demo-runs.jsonl
# AUDIT_DEMO_DISABLED=1
# 非 DRAFT_READY 时向 stdout 打 JSON 行 event=demo_pipeline_timing（含 wallClockMs、timingsMs）；设 0 关闭
# DEMO_TIMING_LOG_STDOUT=0

# Harness orchestrator 审计：memory | file
# AUDIT_SINK=memory
# AUDIT_JSONL_PATH=./data/audit-harness.jsonl

# 历史变量：主链路当前不再按输入长度硬拦截模型（仅保留空输入拦截）
# INPUT_MAX_CHARS=3000

# 钉钉单机会话 TTL（毫秒）与同会话速率限制窗口
# CHAT_SESSION_TTL_MS=1800000
# RATE_LIMIT_WINDOW_MS=5000

# Demo 快照目录（pipeline DRAFT_READY）
# PLAN_STORE_DIR=./data/plans
# 本地/单元测试禁用写盘：`PLAN_SNAPSHOT_DISABLED=1`

# Markdown 产出 PII 脱敏（手机号/身份证/IPv4）；测试可设 CONTENT_FILTER_DISABLED=1 关闭
# CONTENT_FILTER_DISABLED=1

# --- Assignment phase (post DRAFT_READY) ---
# ASSIGNMENT_DRAFT_DIR=./data/plans
# EMPLOYEE_PROFILE_DIR=./data/employees/profiles   # 兼容旧脚本；运行时员工画像已迁移到 SQLite
# EMPLOYEE_FIXTURE_SOURCE=./fixtures/employees-seed.json
# ASSIGNMENT_EVENTS_PATH=./data/events/assignment-events.jsonl
# CARD_CALLBACKS_PATH=./data/events/card-callbacks.jsonl
# CARD_STATE_DIR=./data/cards
# DINGTALK_ASSIGNMENT_MOCK=1
# 预留白名单变量（当前 dingtalk 主链路暂未接入 initiator-whitelist）
# TASK_INITIATOR_USER_IDS=user1,user2
# TASK_INITIATOR_IDS_FILE=./data/initiators.json
# 主管工作台身份（与发起人独立；钉钉网页应用 Session 判定时使用）：未配置则人均非主管
# WORKBENCH_MANAGER_USER_IDS=
# WORKBENCH_MANAGER_IDS_FILE=./data/workbench-managers.json
# 动态主管名单（权限中心 / set_manager_permission 写入；与 env 并集）
# WORKBENCH_DYNAMIC_MANAGER_IDS_FILE=./data/workbench-managers.json
# Manager groups let multiple supervisors share one formal-task/project scope.
# Keep disabled on existing instances until Admin creates/migrates groups.
# WORKBENCH_MANAGER_GROUPS_ENABLED=0
# WORKBENCH_MANAGER_GROUPS_FILE=./data/workbench-manager-groups.json
# Admin 工作台身份（运营看板、权限中心、admin 工具 profile）：仅 env；改后须重建容器
# WORKBENCH_ADMIN_USER_IDS=
# WORKBENCH_ADMIN_IDS_FILE=./data/workbench-admins.json
# 手动追加子任务内容去重窗口（秒）；默认 60；设 0 关闭（仅调试）
# WORKBENCH_APPEND_SUBTASK_DEDUP_SECONDS=60
# 主管工作台危险操作二次确认 + 幂等键（建议生产 1）
# WORKBENCH_ENFORCE_ACTION_GUARDS=1
# 单轮 orchestrator add_draft_subtask 上限（默认 4）
# ADD_DRAFT_SUBTASK_PER_ORCHESTRATOR_MAX=4
# 项目（Portfolio）可选层：名单内主管启用项目总览 + 历史任务归档；默认空=全员角色 B
# WORKBENCH_PROJECT_PORTFOLIO_USER_IDS=
# WORKBENCH_PROJECT_PORTFOLIO_IDS_FILE=./data/workbench-portfolio-managers.json
ASSIGNMENT_PHASE_ENABLED=1
# ASSIGNMENT_WEB_SECRET=change-me-min-32-chars-random
# ASSIGNMENT_WEB_PORT=8787
# ASSIGNMENT_WEB_PUBLIC_BASE_URL=https://your-ecs-host
# 员工/主管通知卡片详情链（每实例独立域名；组织 B 示例见 docs/deploy-aliyun-dingtalk.md）
# WORKBENCH_NOTIFY_DETAIL_URL_BASE=https://your-ecs-host/workbench/employee/task
# WORKBENCH_NOTIFY_MANAGER_DETAIL_URL_BASE=https://your-ecs-host

# --- External executor web login (non-DingTalk assignees) ---
# WORKBENCH_EXTERNAL_LOGIN_ENABLED=1
# WORKBENCH_COOKIE_SECURE=1
# EXTERNAL_EXECUTOR_INITIAL_PASSWORD=change-me-min-8-chars

# --- DingTalk contacts sync (SQLite local snapshot) ---
# DINGTALK_CONTACT_SYNC_ENABLED=1
# DINGTALK_CONTACT_SYNC_INTERVAL_MS=1800000
# DINGTALK_CONTACT_ROOT_DEPT_ID=1
# DINGTALK_CONTACT_EVENT_TOKEN=replace-with-random-shared-secret
