# 复制为 .env 并填入密钥（.env 已被 git 忽略，切勿提交）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次请求超时（毫秒）。模型 JSON 较慢时建议 60000+，避免 Abort / fetch failed
# QWEN_TIMEOUT_MS=60000
# QWEN_MAX_RETRIES=2
# OpenAI 兼容 SSE 流式拼装 JSON（默认开启）；关闭请设 QWEN_STREAM=0
# QWEN_STREAM=0

# 钉钉：是否推送流式进度气泡（默认关；需显式 DINGTALK_STREAM_PROGRESS=1）
# DINGTALK_STREAM_PROGRESS=1
# DINGTALK_STREAM_PROGRESS_MS=3000

# 钉钉开放平台「企业内部应用」Stream 机器人（https://open.dingtalk.com）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 可选：调试 Stream SDK（1 / true）
# DINGTALK_STREAM_DEBUG=1

# 任务规划前是否先发「处理中」提示（默认关；仅 DINGTALK_QUICK_ACK=1 开启）
# DINGTALK_QUICK_ACK=1

# 可选：默认域提示 QUALITY | RD（不明确时可不设，交由模型判断）
# DEMO_DOMAIN_HINT=QUALITY

# 可选：健康检查端口（GET /health），便于阿里云负载均衡探活
# HEALTH_CHECK_PORT=8080

# Demo pipeline JSONL 审计（每条 createTaskPlanningDemo 完结一行）
# AUDIT_DEMO_JSONL_PATH=./data/demo-runs.jsonl
# AUDIT_DEMO_DISABLED=1

# Harness orchestrator 审计：memory | file
# AUDIT_SINK=memory
# AUDIT_JSONL_PATH=./data/audit-harness.jsonl

# 输入单次最大字符（超出则 NEEDS_MORE_INFO 提示拆分，不切静默）
# INPUT_MAX_CHARS=3000

# 钉钉单机会话 TTL（毫秒）与同会话速率限制窗口
# CHAT_SESSION_TTL_MS=1800000
# RATE_LIMIT_WINDOW_MS=5000

# Demo 快照目录（pipeline DRAFT_READY）
# PLAN_STORE_DIR=./data/plans
# 本地/单元测试禁用写盘：`PLAN_SNAPSHOT_DISABLED=1`

# Markdown 产出 PII 脱敏（手机号/身份证/IPv4）；测试可设 CONTENT_FILTER_DISABLED=1 关闭
# CONTENT_FILTER_DISABLED=1
