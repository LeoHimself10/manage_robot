{
  "name": "manage-robot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run build:workbench-login && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "demo:eval": "tsx src/demo-eval.ts",
    "demo:scenarios": "tsx scripts/run-qwen-scenarios.ts",
    "demo:hi-latency": "tsx scripts/qwen-hi-latency.ts",
    "dingtalk-bot": "tsx src/dingtalk-bot.ts",
    "seed:employees": "tsx scripts/seed-employee-profiles.ts",
    "build:workbench-login": "esbuild src/web/workbench-dd-login-entry.ts --bundle --platform=browser --format=iife --legal-comments=none --outfile=dist/workbench-dd-login.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "dingtalk-jsapi": "^3.2.9",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0"
  }
}
