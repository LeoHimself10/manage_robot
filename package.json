{
  "name": "manage-robot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run build:workbench-login && npm run build:workbench-draft-grid && npm run lint:inline-pages && vitest run",
    "lint:inline-pages": "node --import tsx scripts/lint-inline-pages.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "demo:eval": "tsx src/demo-eval.ts",
    "demo:scenarios": "tsx scripts/run-qwen-scenarios.ts",
    "demo:hi-latency": "tsx scripts/qwen-hi-latency.ts",
    "eval:unit": "tsx scripts/run-eval-unit.ts",
    "eval:integration": "tsx scripts/run-eval-integration.ts",
    "eval:spot": "tsx scripts/run-eval-spot.ts",
    "eval:chains": "tsx scripts/run-eval-chains.ts",
    "eval:release": "tsx scripts/run-eval-release.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "eval:agent": "tsx scripts/run-agent-eval.ts",
    "eval:wbs-manager": "tsx scripts/run-wbs-manager-eval.ts",
    "eval:assignment-gate": "vitest run tests/agent/assignment/assignment-gate-invariants.test.ts && tsx scripts/run-assignment-gate-eval.ts",
    "eval:assignment-scope-switch": "vitest run tests/agent/assignment/assignment-scope-conversation.test.ts && tsx scripts/run-assignment-scope-switch-eval.ts",
    "eval:deployment-parity": "node --import tsx scripts/eval-deprecated-forward.ts deployment-parity",
    "eval:natural-full": "node --import tsx scripts/eval-deprecated-forward.ts natural-full",
    "eval:replay-transport": "node --import tsx scripts/eval-deprecated-forward.ts replay-transport",
    "eval:publish-short": "tsx scripts/run-publish-short-confirm-eval.ts",
    "eval:cross-channel": "vitest run tests/web/canonical-main-session.test.ts && tsx scripts/run-cross-channel-parity-eval.ts",
    "eval:parity-suite": "npm run eval:assignment-gate && npm run eval:cross-channel && npm run eval:publish-short",
    "eval:read-url": "tsx scripts/run-read-url-eval.ts",
    "eval:project-portfolio": "tsx scripts/run-project-portfolio-eval.ts",
    "eval:portfolio-regression": "tsx scripts/run-portfolio-regression-eval.ts",
    "eval:portfolio-spot": "tsx scripts/run-portfolio-spot-eval.ts",
    "eval:portfolio-chains": "tsx scripts/run-portfolio-chains-eval.ts",
    "eval:portfolio-full": "tsx scripts/run-portfolio-full-eval.ts",
    "eval:portfolio-suite": "npm run eval:portfolio-regression && npm run eval:project-portfolio && npm run eval:assignment-gate",
    "eval:meeting-import": "tsx scripts/run-meeting-import-eval.ts",
    "eval:judge-calibrate": "tsx scripts/calibrate-online-judge.ts",
    "dingtalk-bot": "tsx src/dingtalk-bot.ts",
    "seed:employees": "tsx scripts/seed-employee-profiles.ts",
    "seed:external-executors": "tsx scripts/seed-external-executors.ts",
    "dev:external-workbench": "tsx scripts/local-external-workbench-dev.ts",
    "dev:manager-chat": "tsx scripts/local-manager-chat-dev.ts",
    "dev:manager-chat:keep": "tsx scripts/local-manager-chat-dev.ts --keep-data",
    "dev:task-intake": "tsx scripts/local-task-intake-dev.ts",
    "dev:task-intake:keep": "tsx scripts/local-task-intake-dev.ts --keep-data",
    "dev:microcatheter-repro": "tsx scripts/local-microcatheter-repro-dev.ts",
    "test:displayname-local": "tsx scripts/local-test-displayname-fix.ts",
    "test:assignment-scope": "vitest run tests/agent/assignment/resolve-turn-assignment.test.ts tests/agent/assignment/assignment-scope-conversation.test.ts tests/agent/assignment/assignment-gate-invariants.test.ts tests/agent/manager-orchestrator-turn.test.ts tests/agent/workbench/conversation-turn-display.test.ts tests/agent/tools/start-new-task.test.ts tests/agent/tools/switch-back-task.test.ts tests/view/draft-outbound.test.ts tests/agent/scope-message-truncate.test.ts",
    "build:workbench-login": "esbuild src/web/workbench-dd-login-entry.ts --bundle --platform=browser --format=iife --legal-comments=none --outfile=dist/workbench-dd-login.js",
    "build:workbench-draft-grid": "esbuild src/web/workbench-draft-grid-entry.ts --bundle --platform=browser --format=iife --global-name=WorkbenchDraftGrid --legal-comments=none --outfile=dist/workbench-draft-grid.js"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "dingtalk-jsapi": "^3.2.9",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "tsx": "^4.21.0"
  }
}
